# Copy to the git-ignored credentials file and fill in your real values:
#   $CAMERA_MCP_CREDENTIALS, else ~/.config/camera-mcp/credentials (chmod 600).
# Plain KEY=value lines; only whole-line # comments and blank lines are ignored (a # after a
# value is NOT a comment — it becomes part of the value). Surrounding quotes are stripped.
# Every key here may instead be set in the environment, which wins over the file. Nothing in
# this file should ever be committed with real values.

# --- Camera login (required to open any camera) --------------------------------------------
# The Tapo "Camera Account" user/password. On a desktop Mac these can instead live in the
# login Keychain (see the README); the file is the fallback for headless/SSH hosts.
CAMERA_USER=camera
CAMERA_PASS=change-me

# --- Email for the morning brief (optional; needed only to send the brief by email) ---------
# SMTP_HOST is the mail server (required to send mail).
SMTP_HOST=smtp.example.com
# SMTP_PORT: 587 = STARTTLS (default), 465 = SSL.
SMTP_PORT=587
# SMTP_FROM is the sender address (required).
SMTP_FROM=camera@example.com
# SMTP_TO is the recipient; comma-separated for several (required).
SMTP_TO=you@example.com
# SMTP_USER is the login user (defaults to SMTP_FROM).
SMTP_USER=camera@example.com
# SMTP_PASS is the login password (omit for an unauthenticated relay).
SMTP_PASS=change-me
# SMTP_CA_FILE: a CA bundle override, for a private/self-signed mail server. Leave unset
# to use the default bundle.
# SMTP_CA_FILE=/path/to/ca.pem
# SMTP_INSECURE: 1/true/yes disables TLS verification (use only if you must). Default off.
# SMTP_INSECURE=0

# --- Real-time alerts (optional) ------------------------------------------------------------
# Where a sighting of an alert_species (set in cameras.yaml) sends a text, via an email->SMS
# gateway. Example for AT&T: 15551234567@txt.att.net. Leave unset for no alerts.
SMS_ALERT_TO=15551234567@txt.att.net
